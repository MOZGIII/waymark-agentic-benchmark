# Template for .env, which lib/common.sh loads and git ignores. Copy this file to
# .env on the experiments host and fill it in. Variables are added here when
# something in bin/ starts reading them.

# Which tf/experiment/<provider> root creates the VMs: hetzner, linode or scaleway.
BENCH_PROVIDER=hetzner
# API token of the selected provider, read by its OpenTofu provider.
HCLOUD_TOKEN=
LINODE_TOKEN=
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_DEFAULT_PROJECT_ID=
# Private key the host uses to reach the VMs; the matching .pub is installed on
# them. Relative to the project root; the default is git-ignored, and
# experiment-create generates the key there on first use.
BENCH_SSH_KEY=.local/ssh/bench

# Which agent CLI runs the task and with which model, unless the run's manifest
# says otherwise. The agent's credential goes to the workstation at launch: use
# a dedicated key with a spend limit. Claude Code alternatively takes the token
# from `claude setup-token` for subscription use; the key wins when both are set.
BENCH_AGENT=claude
BENCH_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=
# Budgets per run: total tokens of all kinds, agent turns, and wall-clock
# seconds. They catch runaways, so they sit well above what a finished run
# needs: a first real run used about 3 responses and 150k tokens a minute.
BENCH_TOKEN_BUDGET=50000000
BENCH_TURN_BUDGET=1000
BENCH_WALL_BUDGET=14400
